<main>
    <h1>Agregar Producto</h1>
    <form action="/admin/agregar-producto" method="POST">
        <p>
            <label for="nombre">Nombre del producto:</label>
            <input type="text" id="nombre" name="nombre" placeholder="Nombre del producto">
        </p>
        <p>
            <label for="precio">Precio del producto:</label>
            <input type="text" id="precio" name="precio" placeholder="Precio del producto">
        </p>
        <p>
            <label for="imagen">URL de la imagen del producto:</label>
            <input type="text" id="imagen" name="imagen" placeholder="URL de la imagen del producto">
        </p>
        <p>
            <label for="disponible">Disponible:</label>
            <input type="hidden" name="disponible" value="false">
            <input type="checkbox" id="disponible" name="disponible" value="true">
        </p>
        <button type="submit" class="btn">Agregar Producto</button>
    </form>
</main>
