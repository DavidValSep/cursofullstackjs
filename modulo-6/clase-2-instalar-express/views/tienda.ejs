<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tienda</title>
    <link rel="stylesheet" href="/main.css">
</head>
<body>
    <header>
        <nav>
            <ul>
                <li class=""><a href="/">Home</a></li>
                <li><a href="/admin/agregar-producto">Agregar Producto</a></li>
            </ul>
        </nav>
    </header>
    <main>
        <h1>Mis Productos</h1>
        <div class="btn-group">
            <a href="/?ordenar=nombre" class="btn">Ordenar por Nombre</a>
            <a href="/?ordenar=precio" class="btn">Ordenar por Precio</a>
        </div>
        <% if (productos.length > 0) { %>
            <ul class="products">
                <% productos.forEach(producto => { %>
                    <li class="product-item">
                        <img src="<%= producto.imagen %>" alt="<%= producto.titulo %>" class="product-image">
                        <h2 class="product-title"><%= producto.titulo %></h2>
                        Precio: $<%= producto.precio %>
                    </li>
                <% }) %>
            </ul>
        <% } else { %>
            <p>No hay productos en la tienda.</p>
        <% } %>
    </main>
    <script>

    </script>
</body>
</html>