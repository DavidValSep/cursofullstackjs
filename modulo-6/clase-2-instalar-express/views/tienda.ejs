<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tienda</title>
    <link rel="stylesheet" href="/main.css">
</head>
<body>
    <header>
        <nav>
            <ul>
                <li><a href="/">Home</a></li>
                <li><a href="/admin/agregar-producto">Agregar Producto</a></li>
            </ul>
        </nav>
    </header>
    <main>
        <h1>Mis Productos</h1>
        <% if (productos.length > 0) { %>
            <ul>
                <% productos.forEach(producto => { %>
                    <li><%= producto.titulo %></li>
                <% }) %>
            </ul>
        <% } else { %>
            <p>No hay productos en la tienda.</p>
        <% } %>
    </main>
</body>
</html>