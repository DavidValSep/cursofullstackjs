<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <link rel="stylesheet" href="/main.css">
    <title>Expediente de Mascotas</title>
</head>
<body>
    <div class="owner-card" style="max-width: 600px; margin: 40px auto; padding: 20px; border: 1px solid #ccc; border-radius: 8px;">
        
        <h2>Expediente del Propietario</h2>
        <hr>
        <p><strong>Nombre del Dueño:</strong> {{dueno.nombre_dueno}}</p>
        <p><strong>RUT:</strong> {{dueno.rut_dueno}}</p>
        <div class="actions" style="margin-top: 20px;">
            <button onclick="vaciarMascotas('{{dueno.rut_dueno}}')" class="btn-delete" style="background-color: #e74c3c; width: 100%;">
                Vaciar todas las mascotas 🗑️
            </button>
        </div>
        <div class="pet-list-container" style="margin-top: 20px;">
            <h3>Mascotas Registradas:</h3>
            <ul style="list-style: none; padding: 0;">
                {{#each dueno.mascotas}}
                <li style="background: #f4f4f4; margin-bottom: 10px; padding: 10px; border-radius: 5px;">
                    <strong>Nombre:</strong> {{this.nombre}} <br>
                    <strong>Especie:</strong> {{this.especie}} <br>
                    <strong>ID:</strong> {{this.id}}
                </li>
                {{/each}}
            </ul>
        </div>

        <div class="actions" style="margin-top: 20px;">
            <a href="/" class="btn-secondary">Volver al listado principal</a>
        </div>
    </div>
<script>
        function vaciarMascotas(rut) {
            console.log("Intentando vaciar mascotas para el RUT:", rut); // Para debug en consola F12
            
            if (confirm('¿Estás seguro de eliminar TODAS las mascotas de este RUT?')) {
                fetch('/eliminar-por-rut/' + rut, { 
                    method: 'DELETE' 
                })
                .then(response => {
                    if (!response.ok) throw new Error('Error en la respuesta del servidor');
                    return response.text();
                })
                .then(mensaje => {
                    alert(mensaje);
                    window.location.href = '/'; // Redirige al inicio
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('No se pudo eliminar: ' + error.message);
                });
            }
        }
    </script>
</body>
</html>