<div class="owner-card" style="max-width: 500px; margin: 0 auto;">
    <h2>Agregar Mascota</h2>
    <hr>
    <form action="/agregar-mascota" method="POST">
    <p><strong>Nombre:</strong> <input type="text" name="nombre" id="nombre"></p>
    <p><strong>Especie:</strong> <input type="text" name="especie" id="especie"></p>
    <p><strong>ID de Registro:</strong> <input type="text" name="id" id="id"></p>
    <p><strong>RUT del Dueño:</strong> <input type="text" name="rut_dueno" id="rut_dueno"></p>
    <div class="actions">
        <button type="submit" class="btn-primary">Guardar Mascota</button>
        <a href="/" class="btn-secondary">Volver al listado</a>
    </div>
    </form>
    </div>