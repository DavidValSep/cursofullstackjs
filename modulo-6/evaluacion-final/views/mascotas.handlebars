<div class="container">
    <h1>Registro Nacional de Mascotas</h1>

    <div class="catalog-list">
        {{#each duenos}}
        <div class="owner-card">
            <div class="owner-info">
                <h3>Dueño: {{this.nombre_dueno}}</h3>
                <p><strong>RUT:</strong> {{this.rut_dueno}}
                <a href="/rut/{{this.rut_dueno}}" class="btn btn-secondary">Ver Rut</a></p>
            </div>

            <div class="pet-list-container">
                <strong>Mascotas:</strong>
                <ul>
                    {{#each this.mascotas}}
                    <li>
                        <strong>🐾 {{this.nombre}}</strong> ({{this.especie}})
                        <br>
                        <a href="/mascota/{{this.id}}" class="btn btn-secondary">Ver Ficha</a>
                        <button onclick="eliminarMascota('{{this.nombre}}')" class="btn btn-secondary">Eliminar 🗑️</button>
                    </li>
                    {{/each}}
                </ul>
            </div>

            <div class="actions">
                <!-- Botón de ejemplo para ver detalle del dueño -->
                <a href="/rut/{{this.rut_dueno}}" class="btn">Gestionar Dueño</a>
            </div>
        </div>
        {{/each}}
    </div>
</div>
<script>
function eliminarMascota(nombre) {
    if(confirm('¿Seguro que quieres eliminar a ' + nombre + '?')) {
        fetch('/eliminar/' + nombre, { method: 'DELETE' })
        .then(res => res.text())
        .then(msg => {
            alert(msg);
            location.reload(); // Recarga para ver los cambios
        });
    }
}
</script>